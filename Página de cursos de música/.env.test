# Local api:test only — trivial container credentials (postgres/postgres).
# Not production. Used solely by npm run api:test:local.
# Cite: Juan "OK fix" · GAP-FIX F-ADITIVA.
# Keys below are pinned so Prisma's auto-load of .env cannot redirect the
# student email / activation key away from the seeded fixtures.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/gmusic_test?schema=public
ADMIN_SEED_PASSWORD=postgres
JWT_SECRET=gmusic-test-jwt-secret-local-only
ADMIN_PASSWORD_RESET_KEY=test-admin-reset-key-24chars-min
GMUSIC_DEV_USER_EMAIL=carlos@gmusic.academy
GMUSIC_DEV_ACTIVATION_KEY=test-dev-activation-key-24chars
