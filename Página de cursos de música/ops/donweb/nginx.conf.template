# Include from nginx http context. Render placeholders before nginx -t.
# Do not log query strings (media bearer signatures).
log_format gmusic_no_query '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 80;
    server_name __DOMAIN__;
    root "/srv/gmusic/current/Página de cursos de música/dist";
    index index.html;
    client_max_body_size 52m;
    access_log /var/log/nginx/gmusic-access.log gmusic_no_query;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_buffering off;
        # Range and If-Range are forwarded by default. No proxy cache.
    }
    # Canonical storage identifiers must never expose files without a signature.
    location ^~ /storage/ { return 404; }
    location ~ /\. { deny all; }
    location ~ \.map$ { return 404; }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
